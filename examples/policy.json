{
  "version": "1",
  "default_audience": "agent-runtime",
  "default_ttl_seconds": 3600,
  "default_max_depth": 2,
  "default_kid": "key-2025",
  "tools": [
    {
      "name": "read_file",
      "arg_keys": ["path", "limit", "score", "query"],
      "constraints": {
        "path": { "type": "prefix", "value": "/tmp/" },
        "limit": { "type": "int_range", "value": { "min": 1, "max": 100 } },
        "score": { "type": "float_range", "value": { "min": 0.5, "max": 10.5 } },
        "query": { "type": "len_range", "value": { "min": 1, "max": 16 } }
      }
    },
    {
      "name": "list_dir",
      "arg_keys": ["path"],
      "constraints": {
        "path": { "type": "not", "value": { "type": "prefix", "value": "/etc/" } }
      },
      "ttl_seconds": 300,
      "max_depth": 1
    }
  ]
}
