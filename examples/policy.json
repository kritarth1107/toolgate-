{
  "version": "1",
  "default_audience": "agent-runtime",
  "default_ttl_seconds": 3600,
  "default_max_depth": 2,
  "default_kid": "key-2025",
  "tools": [
    {
      "name": "read_file",
      "arg_keys": ["path", "roots", "limit", "score", "query", "title", "ext", "note", "memo", "file", "skip"],
      "constraints": {
        "path": { "type": "prefix", "value": "/tmp/" },
        "roots": { "type": "prefix_one_of", "value": ["/tmp/", "/var/"] },
        "limit": { "type": "int_range", "value": { "min": 1, "max": 100 } },
        "score": { "type": "float_range", "value": { "min": 0.5, "max": 10.5 } },
        "query": { "type": "len_range", "value": { "min": 1, "max": 16 } },
        "title": { "type": "char_len_range", "value": { "min": 1, "max": 16 } },
        "ext": { "type": "suffix_one_of", "value": [".txt", ".md"] },
        "note": { "type": "contains_any", "value": ["tmp", "var"] },
        "memo": { "type": "contains_none", "value": ["secret", "password"] },
        "file": { "type": "matches_any", "value": ["*.txt", "*.md"] },
        "skip": { "type": "matches_none", "value": ["*.tmp", "*.bak"] }
      }
    },
    {
      "name": "list_dir",
      "arg_keys": ["path"],
      "constraints": {
        "path": { "type": "not", "value": { "type": "prefix", "value": "/etc/" } }
      },
      "ttl_seconds": 300,
      "max_depth": 1
    }
  ]
}
