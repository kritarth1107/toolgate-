{
  "version": "1",
  "default_audience": "agent-runtime",
  "default_ttl_seconds": 3600,
  "default_max_depth": 2,
  "default_kid": "key-2025",
  "tools": [
    {
      "name": "read_file",
      "arg_keys": ["path", "roots", "limit", "score", "floor", "ceiling", "open_floor", "open_ceiling", "query", "title", "ext", "note", "memo", "file", "skip", "dest", "name", "mode", "port", "choice", "bias", "pin", "label", "caption", "handle", "blurb", "nick", "retries", "cap", "open_retries", "open_cap"],
      "required_keys": ["path"],
      "constraints": {
        "path": { "type": "prefix", "value": "/tmp/" },
        "roots": { "type": "prefix_one_of", "value": ["/tmp/", "/var/"] },
        "limit": { "type": "int_range", "value": { "min": 1, "max": 100 } },
        "score": { "type": "float_range", "value": { "min": 0.5, "max": 10.5 } },
        "floor": { "type": "min_float", "value": 0.5 },
        "ceiling": { "type": "max_float", "value": 10.5 },
        "open_floor": { "type": "exclusive_min_float", "value": 0.5 },
        "open_ceiling": { "type": "exclusive_max_float", "value": 10.5 },
        "query": { "type": "len_range", "value": { "min": 1, "max": 16 } },
        "title": { "type": "char_len_range", "value": { "min": 1, "max": 16 } },
        "ext": { "type": "suffix_one_of", "value": [".txt", ".md"] },
        "note": { "type": "contains_any", "value": ["tmp", "var"] },
        "memo": { "type": "contains_none", "value": ["secret", "password"] },
        "file": { "type": "matches_any", "value": ["*.txt", "*.md"] },
        "skip": { "type": "matches_none", "value": ["*.tmp", "*.bak"] },
        "dest": { "type": "prefix_none", "value": ["/etc/", "/root/"] },
        "name": { "type": "suffix_none", "value": [".bak", ".tmp"] },
        "mode": { "type": "int_one_of", "value": [1, 2, 3] },
        "port": { "type": "int_none", "value": [0, -1] },
        "choice": { "type": "float_one_of", "value": [0.5, 1.5, 2.5] },
        "bias": { "type": "float_none", "value": [0.0, -1.0] },
        "pin": { "type": "len_one_of", "value": [4, 8, 16] },
        "label": { "type": "len_none", "value": [0, 1] },
        "caption": { "type": "char_len_one_of", "value": [4, 8, 16] },
        "handle": { "type": "char_len_none", "value": [0, 1] },
        "blurb": { "type": "min_char_len", "value": 3 },
        "nick": { "type": "max_char_len", "value": 16 },
        "retries": { "type": "min_int", "value": 1 },
        "cap": { "type": "max_int", "value": 100 },
        "open_retries": { "type": "exclusive_min_int", "value": 1 },
        "open_cap": { "type": "exclusive_max_int", "value": 100 }
      }
    },
    {
      "name": "list_dir",
      "arg_keys": ["path"],
      "required_keys": ["path"],
      "constraints": {
        "path": { "type": "not", "value": { "type": "prefix", "value": "/etc/" } }
      },
      "ttl_seconds": 300,
      "max_depth": 1
    }
  ]
}
